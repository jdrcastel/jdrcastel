---
import Section from "./Section.astro";
import ProjectsGrid, { type Project } from "./ProjectsGrid";
import type { Content } from "@/i18n";
import { projectMeta } from "@/i18n/shared";

interface Props {
  t: Content;
}
const { t } = Astro.props;

const projects: Project[] = t.projects.items.map((item) => ({ ...item, ...projectMeta[item.id] }));
---

<Section id="projects" eyebrow={t.projects.eyebrow} title={t.projects.title} lead={t.projects.lead}>
  <ProjectsGrid
    client:visible
    projects={projects}
    labels={{
      title: t.projects.title,
      filters: t.projects.filters,
      status: t.projects.status,
      learnMore: t.projects.learnMore,
      stackLabel: t.projects.stackLabel,
      links: t.projects.links,
      diagram: t.projects.diagram,
    }}
  />
</Section>
