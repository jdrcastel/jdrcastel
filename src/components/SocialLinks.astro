---
// LinkedIn and GitHub as icon buttons. LinkedIn's logo isn't in Simple Icons (trademark), so its path is inline.
import { siGithub } from "simple-icons";
import { buttonVariants } from "@/components/ui/button";
import { person } from "@/i18n/shared";
import { cn } from "@/lib/utils";

interface Props {
  size?: "icon" | "icon-lg";
}
const { size = "icon-lg" } = Astro.props;

const linkedinPath =
  "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z";
const links = [
  { label: "LinkedIn", href: person.linkedin, path: linkedinPath },
  { label: "GitHub", href: person.github, path: siGithub.path },
];
---

{links.map(({ label, href, path }) => (
  <a
    href={href}
    target="_blank"
    rel="noopener"
    aria-label={label}
    title={label}
    class={cn(buttonVariants({ variant: "ghost", size }), "hover:text-brand")}
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={path} /></svg>
  </a>
))}
