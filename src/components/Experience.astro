---
import Section from "./Section.astro";
import ExperienceList from "./ExperienceList";
import type { Content } from "@/i18n";

interface Props {
  t: Content;
}
const { t } = Astro.props;
---

<Section id="experience" eyebrow={t.experience.eyebrow} title={t.experience.title} lead={t.experience.lead}>
  <div class="max-w-3xl">
    <ExperienceList client:visible labels={t.experience} />
  </div>
</Section>
