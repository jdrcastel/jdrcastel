---
import { learning } from "../data/profile";
---

<section id="learning">
  <div class="wrap">
    <div data-reveal>
      <div class="eyebrow">// learning now</div>
      <h2>Building with <span class="grad-text">AI agents</span> and AI integrations</h2>
      <p class="lead">
        My current focus: working with AI coding agents and putting LLMs inside real apps, plus Java and Spring Boot for
        the backend. I keep this separate from my skills on purpose: I'm learning it and applying it, not claiming to
        master it yet.
      </p>
    </div>

    <div class="grid g3">
      {learning.map((l, i) => (
        <div class:list={["card", "item", { ai: i < 2 }]} data-reveal style={`transition-delay:${i * 80}ms`}>
          <div class="head">
            <div class="ico">{l.icon}</div>
            <h3>{l.title}</h3>
          </div>
          <p>{l.summary}</p>
          <div class="chips">
            {l.items.map((t) => <span class="chip learn">{t}</span>)}
          </div>
          <div class="applying">
            <span>Applying it in</span>
            {l.applying}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .item { display: flex; flex-direction: column; gap: 12px; }
  .ai {
    background:
      linear-gradient(var(--surface), var(--surface)) padding-box,
      linear-gradient(135deg, var(--accent), var(--accent-2), var(--accent-3)) border-box;
    border: 1px solid transparent;
  }
  .item p { margin: 0; }
  .head { display: flex; align-items: center; gap: 10px; }
  .head h3 { margin: 0; }
  .ico {
    width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; flex: none;
    background: var(--accent-soft); font-size: 18px;
  }
  .applying {
    margin-top: auto; font-size: 14px; color: var(--text); padding-top: 12px; border-top: 1px dashed var(--border);
  }
  .applying span {
    display: block; font: 600 11px Inter, sans-serif; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--accent); margin-bottom: 4px;
  }
</style>
