---
import { building } from "../data/profile";

const label = { done: "Done", "in-progress": "In progress", planned: "Planned" } as const;
---

<section id="building">
  <div class="wrap">
    <div data-reveal>
      <div class="eyebrow">// now building</div>
      <h2>{building.name}</h2>
      <p class="lead">{building.pitch}</p>
    </div>

    <div class="layout">
      <div class="card why" data-reveal>
        <h3>Why this project</h3>
        <p>{building.why}</p>
        <div class="chips">
          {["TypeScript", "Node.js", "Express", "PostgreSQL", "Prisma", "Zod", "JWT", "Vitest", "Docker", "GitHub Actions", "AWS", "React"].map((t) => (
            <span class="chip">{t}</span>
          ))}
        </div>
      </div>

      <ol class="phases" data-reveal>
        {building.phases.map((ph, i) => (
          <li class={ph.status}>
            <span class="num">{i + 1}</span>
            <div>
              <div class="row">
                <b>{ph.title}</b>
                <span class={`state ${ph.status}`}>{label[ph.status]}</span>
              </div>
              <small>{ph.detail}</small>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 16px; align-items: start; }
  @media (max-width: 820px) { .layout { grid-template-columns: minmax(0, 1fr); } }
  .why h3 { margin-bottom: 8px; }
  .phases {
    list-style: none; margin: 0; padding: 6px 18px; background: var(--surface); border: 1px solid var(--border);
    border-radius: 14px;
  }
  .phases li { display: flex; gap: 14px; padding: 12px 0; border-bottom: 1px dashed var(--border); }
  .phases li > div { flex: 1; min-width: 0; }
  .phases li:last-child { border-bottom: 0; }
  .num {
    flex: none; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center;
    font: 600 13px "JetBrains Mono", monospace; background: var(--surface-2); color: var(--muted);
  }
  .in-progress .num { background: var(--accent); color: #fff; }
  .done .num { background: var(--ok); color: #fff; }
  .row { display: flex; justify-content: space-between; gap: 10px; align-items: center; }
  .phases b { font-size: 15px; }
  .phases small { display: block; color: var(--muted); font-size: 13.5px; margin-top: 2px; }
  .state { font: 600 11px Inter, sans-serif; padding: 3px 8px; border-radius: 6px; white-space: nowrap; }
  .state.planned { background: var(--surface-2); color: var(--muted); }
  .state.in-progress { background: var(--warn-soft); color: var(--warn); }
  .state.done { background: var(--ok-soft); color: var(--ok); }
</style>
