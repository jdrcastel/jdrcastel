---
import { Download, Mail } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { assetUrl, type Content } from "@/i18n";
import { person } from "@/i18n/shared";
import SocialLinks from "./SocialLinks.astro";

interface Props {
  t: Content;
}
const { t } = Astro.props;
const c = t.contact;
---

<section id="contact" class="py-20" aria-labelledby="contact-title">
  <div class="mx-auto max-w-5xl px-4">
    <Card className="items-center gap-0 px-6 py-14 text-center" data-reveal>
      <p class="font-mono text-xs font-medium tracking-wider text-brand uppercase">{c.eyebrow}</p>
      <h2 id="contact-title" class="mt-2 text-3xl font-semibold tracking-tight text-balance">
        {c.title} <span class="text-brand">{c.highlight}</span>
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-pretty text-muted-foreground">{c.lead}</p>
      <div class="mt-7 flex flex-wrap justify-center gap-2">
        <a href={`mailto:${person.email}`} class={buttonVariants({ size: "lg" })}>
          <Mail aria-hidden="true" />
          {c.email}
        </a>
        <a href={assetUrl(person.resume)} download class={buttonVariants({ variant: "outline", size: "lg" })}>
          <Download aria-hidden="true" />
          {t.nav.resume}
        </a>
        <SocialLinks />
      </div>
      <p class="mt-8 text-sm text-muted-foreground">{c.offClock}</p>
    </Card>
  </div>
</section>
