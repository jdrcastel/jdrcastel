---
import { Menu, Moon, Sun } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { assetUrl, homeUrl, type Content, type Lang } from "@/i18n";
import { person } from "@/i18n/shared";

interface Props {
  t: Content;
  lang: Lang;
}
const { t, lang } = Astro.props;

const other: Lang = lang === "en" ? "es" : "en";
const links = [
  ["#about", t.nav.about],
  ["#casshy", t.nav.casshy],
  ["#projects", t.nav.projects],
  ["#skills", t.nav.skills],
  ["#experience", t.nav.experience],
  ["#contact", t.nav.contact],
];
---

<header class="sticky top-0 z-40 border-b bg-background/80 backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-5xl items-center gap-2 px-4">
    <a href={homeUrl(lang)} class="mr-auto font-semibold tracking-tight" aria-label={person.short}>
      juan<span class="text-brand">.</span>castelblanco
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul id="navLinks" class="flex items-center gap-1 text-sm">
        {links.map(([href, label]) => (
          <li><a href={href} class={buttonVariants({ variant: "ghost", size: "sm" })}>{label}</a></li>
        ))}
      </ul>
    </nav>

    <a
      href={homeUrl(other)}
      hreflang={other}
      lang={other}
      class={buttonVariants({ variant: "outline", size: "sm" }) + " font-mono uppercase"}
      aria-label={t.nav.language}
      title={t.nav.language}
    >
      {other}
    </a>
    <a
      href={assetUrl(person.resume)}
      target="_blank"
      rel="noopener"
      class={buttonVariants({ size: "sm" }) + " hidden sm:inline-flex"}
    >
      {t.nav.resume}
    </a>
    <button id="themeBtn" type="button" class={buttonVariants({ variant: "ghost", size: "icon-sm" })} aria-label={t.nav.theme}>
      <Sun className="hidden dark:block" aria-hidden="true" />
      <Moon className="dark:hidden" aria-hidden="true" />
    </button>
    <button
      id="menuBtn"
      type="button"
      class={buttonVariants({ variant: "ghost", size: "icon-sm" }) + " md:hidden"}
      aria-label={t.nav.menu}
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <Menu aria-hidden="true" />
    </button>
  </div>

  <nav id="mobileMenu" aria-label="Mobile" class="hidden border-t md:hidden">
    <ul class="mx-auto flex max-w-5xl flex-col px-4 py-2">
      {links.map(([href, label]) => (
        <li><a href={href} class="block rounded-md px-2 py-2 text-sm hover:bg-accent">{label}</a></li>
      ))}
      <li><a href={assetUrl(person.resume)} target="_blank" rel="noopener" class="block rounded-md px-2 py-2 text-sm hover:bg-accent">{t.nav.resume}</a></li>
    </ul>
  </nav>
</header>

<script>
  const root = document.documentElement;
  document.getElementById("themeBtn")?.addEventListener("click", () => {
    const dark = root.classList.toggle("dark");
    try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch {}
  });

  const menuBtn = document.getElementById("menuBtn");
  const mobileMenu = document.getElementById("mobileMenu");
  const setMenu = (open: boolean) => {
    mobileMenu?.classList.toggle("hidden", !open);
    menuBtn?.setAttribute("aria-expanded", String(open));
  };
  menuBtn?.addEventListener("click", () => setMenu(mobileMenu?.classList.contains("hidden") ?? false));
  mobileMenu?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setMenu(false);
  });

  // Mark the link of the section in view
  const links = [...document.querySelectorAll<HTMLAnchorElement>("#navLinks a")];
  const observer = new IntersectionObserver(
    (entries) =>
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        links.forEach((l) => {
          const active = l.getAttribute("href") === `#${entry.target.id}`;
          l.classList.toggle("bg-accent", active);
          if (active) l.setAttribute("aria-current", "true");
          else l.removeAttribute("aria-current");
        });
      }),
    { rootMargin: "-45% 0px -50% 0px" },
  );
  document.querySelectorAll("main section[id]").forEach((s) => observer.observe(s));
</script>
