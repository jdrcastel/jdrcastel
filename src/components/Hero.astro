---
import { ArrowRight } from "lucide-react";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import { assetUrl, type Content } from "@/i18n";
import { person } from "@/i18n/shared";

interface Props {
  t: Content;
}
const { t } = Astro.props;

// Render the profile payload as syntax-highlighted JSON
const esc = (v: string) => v.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const val = (v: unknown) =>
  typeof v === "string" ? `<span class="s">"${esc(v)}"</span>` : `<span class="n">${String(v)}</span>`;
// Short arrays stay inline; longer ones get one item per line, like a formatter would
const arr = (key: string, items: unknown[]) => {
  const inline = `[${items.map((x) => `"${x}"`).join(", ")}]`;
  return key.length + inline.length > 45
    ? `[\n${items.map((x) => `    ${val(x)}`).join(",\n")}\n  ]`
    : `[${items.map(val).join(", ")}]`;
};
const json = `{\n${Object.entries(t.hero.payload)
  .map(([k, v]) => `  <span class="t">"${k}"</span>: ${Array.isArray(v) ? arr(k, v) : val(v)}`)
  .join(",\n")}\n}`;
---

<section id="top" class="border-b">
  <div class="mx-auto grid max-w-5xl items-center gap-10 px-4 pt-16 pb-12 lg:grid-cols-[1.1fr_1fr] lg:pt-24">
    <div>
      <Badge variant="outline" className="gap-2 rounded-full px-3 py-1 text-xs font-medium">
        <span class="size-2 rounded-full bg-success" aria-hidden="true"></span>
        {t.hero.status}
      </Badge>
      <h1 class="mt-5 text-4xl font-bold tracking-tight text-balance sm:text-5xl">
        {t.hero.hello}
        <span class="block text-brand">{t.hero.role}</span>
      </h1>
      <p class="mt-5 max-w-xl text-lg text-pretty text-muted-foreground">{t.hero.tagline}</p>
      <div class="mt-7 flex flex-wrap gap-1.5">
        <a href="#projects" class={buttonVariants({ size: "lg" })}>
          {t.hero.ctaProjects}
          <ArrowRight aria-hidden="true" />
        </a>
        <a href={assetUrl(person.resume)} target="_blank" rel="noopener" class={buttonVariants({ variant: "outline", size: "lg" })}>
          {t.hero.ctaResume}
        </a>
        <a href={person.linkedin} target="_blank" rel="noopener" class={buttonVariants({ variant: "ghost", size: "lg" }) + " px-3"}>LinkedIn</a>
        <a href={person.github} target="_blank" rel="noopener" class={buttonVariants({ variant: "ghost", size: "lg" }) + " px-3"}>GitHub</a>
      </div>
    </div>

    <figure class="code-window overflow-hidden rounded-xl border border-white/10 bg-[#0d1117] font-mono text-[13px] leading-relaxed text-[#d6deeb] shadow-lg">
      <div class="flex items-center gap-1.5 border-b border-white/10 bg-white/5 px-4 py-2.5 text-xs text-white/50">
        <span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
        <span class="size-2.5 rounded-full bg-[#febc2e]"></span>
        <span class="size-2.5 rounded-full bg-[#28c840]"></span>
        <span class="ml-2">request.http</span>
      </div>
      <pre class="overflow-hidden px-4 py-4 whitespace-pre-wrap"><span class="k">POST</span> <span class="a">/api/v1/candidates</span> HTTP/1.1
<span class="t">Content-Type</span>: application/json

<Fragment set:html={json} /></pre>
      <figcaption class="flex flex-wrap gap-x-3 border-t border-white/10 bg-black/20 px-4 py-2.5 text-xs text-white/50">
        <span class="font-semibold text-[#28c840]">HTTP/1.1 201 Created</span>
        <span>Location: /api/v1/candidates/juan</span>
      </figcaption>
    </figure>
  </div>

  <ul class="mx-auto grid max-w-5xl grid-cols-2 gap-3 px-4 pb-16 lg:grid-cols-4">
    {t.hero.stats.map((s) => (
      <li>
        <Card className="h-full gap-1 py-4">
          <CardContent className="px-4">
            <p class="text-2xl font-semibold tracking-tight">{s.value}</p>
            <p class="text-sm text-muted-foreground">{s.label}</p>
          </CardContent>
        </Card>
      </li>
    ))}
  </ul>
</section>
