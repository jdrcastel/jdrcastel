---
import { ArrowRight } from "lucide-react";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import type { Content } from "@/i18n";
import SocialLinks from "./SocialLinks.astro";
import TechMarquee from "./TechMarquee.astro";

interface Props {
  t: Content;
}
const { t } = Astro.props;

// Each word of the heading comes into focus in turn (see .hero-word)
const helloWords = t.hero.hello.split(" ");
const roleWords = t.hero.role.split(" ").map((w, i) => ({ w, i: i + helloWords.length }));
---

<section id="top" class="border-b">
  <div class="mx-auto flex max-w-5xl flex-col items-center px-4 pt-24 pb-14 text-center sm:pt-32">
    <Badge variant="outline" className="hero-in gap-2 rounded-full px-3 py-1 text-xs font-medium">
      <span class="relative flex size-2" aria-hidden="true">
        <span class="absolute inline-flex size-full rounded-full bg-success opacity-60 motion-safe:animate-ping"></span>
        <span class="relative inline-flex size-2 rounded-full bg-success"></span>
      </span>
      {t.hero.status}
    </Badge>
    <h1 class="mt-6 text-5xl font-bold tracking-tight text-balance sm:text-7xl">
      <span class="block">{helloWords.map((w, i) => <><span class="hero-word" style={`--i:${i}`}>{w}</span>{" "}</>)}</span>
      <span class="block text-brand">{roleWords.map(({ w, i }) => <><span class="hero-word" style={`--i:${i}`}>{w}</span>{" "}</>)}</span>
    </h1>
    <div class="hero-in mt-10 flex flex-wrap items-center justify-center gap-1.5" style="--d:350ms">
      <a href="#projects" class={buttonVariants({ size: "lg" })}>
        {t.hero.ctaProjects}
        <ArrowRight aria-hidden="true" />
      </a>
      <SocialLinks />
    </div>
  </div>

  <ul class="mx-auto grid max-w-5xl grid-cols-2 gap-3 px-4 pb-12 lg:grid-cols-4">
    {t.hero.stats.map((s, i) => (
      <li class="hero-in" style={`--d:${500 + i * 70}ms`}>
        <Card className="lift h-full gap-1 py-4">
          <CardContent className="px-4">
            <p class="text-2xl font-semibold tracking-tight">{s.value}</p>
            <p class="text-sm text-muted-foreground">{s.label}</p>
          </CardContent>
        </Card>
      </li>
    ))}
  </ul>

  <div class="hero-in" style="--d:800ms">
    <TechMarquee label={t.hero.techLabel} pauseLabel={t.hero.pauseMotion} />
  </div>
</section>
