---
import Section from "./Section.astro";
import SkillsTabs, { type LearningCard, type SkillGroup } from "./SkillsTabs";
import type { Content } from "@/i18n";
import { learningChips, skillChips } from "@/i18n/shared";

interface Props {
  t: Content;
}
const { t } = Astro.props;
const s = t.skills;

const groups: SkillGroup[] = Object.entries(skillChips).map(([id, g]) => ({
  id,
  ...g,
  title: s.groups[id as keyof typeof s.groups],
}));
const learning: LearningCard[] = Object.entries(learningChips).map(([id, l]) => ({
  id,
  ...l,
  ...s.learning[id as keyof typeof s.learning],
}));
---

<Section id="skills" eyebrow={s.eyebrow} title={s.title} lead={s.lead}>
  <SkillsTabs
    client:visible
    groups={groups}
    learning={learning}
    labels={{
      tabSkills: s.tabSkills,
      tabLearning: s.tabLearning,
      legendCore: s.legendCore,
      legendUsed: s.legendUsed,
      applyingLabel: s.applyingLabel,
    }}
  />
</Section>
