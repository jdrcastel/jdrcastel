---
import { skillGroups } from "../data/profile";
---

<section id="skills">
  <div class="wrap">
    <div data-reveal>
      <div class="eyebrow">// tech stack</div>
      <h2>What I build with</h2>
      <p class="lead">
        DevOps and cloud first, backed by backend development and hands-on enterprise troubleshooting. I mark what I'm
        learning right now, because I'd rather be clear than oversell.
      </p>
      <div class="legend"><span><span class="chip hl">highlighted</span> strongest</span><span><span class="chip">plain</span> hands-on</span><span><span class="chip learn">dashed</span> learning now</span></div>
    </div>

    <div class="grid g3">
      {skillGroups.map((g, i) => (
        <div class="card" data-reveal style={`transition-delay:${(i % 3) * 80}ms`}>
          <div class="head">
            <div class="ico">{g.icon}</div>
            <h3>{g.title}</h3>
          </div>
          <div class="chips">
            {g.skills.map((s) => <span class:list={["chip", { hl: s.core, learn: s.learning }]}>{s.name}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .legend { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; color: var(--muted); font-size: 13px; margin: -16px 0 24px; }
  .head { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  .head h3 { margin: 0; }
  .ico {
    width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; flex: none;
    background: var(--accent-soft); font-size: 18px;
  }
</style>
