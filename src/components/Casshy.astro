---
import Section from "./Section.astro";
import { Badge } from "@/components/ui/badge";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import type { Content } from "@/i18n";

interface Props {
  t: Content;
}
const { t } = Astro.props;
const c = t.casshy;
const dot = {
  done: "bg-success",
  inProgress: "bg-warning ring-4 ring-warning/20 motion-safe:animate-pulse",
  planned: "bg-muted-foreground/30",
} as const;
---

<Section id="casshy" eyebrow={c.eyebrow} title="Casshy">
  <Fragment slot="title">
    Casshy <Badge variant="secondary" className="ml-2 align-middle text-xs">{c.status}</Badge>
  </Fragment>

  <p class="-mt-6 mb-3 text-xl font-semibold tracking-tight text-brand" data-reveal>{c.tagline}</p>
  <p class="mb-10 max-w-3xl text-pretty text-muted-foreground" data-reveal>{c.summary}</p>

  <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {c.features.map((f, i) => (
      <li data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
        <Card className="lift h-full flex-row gap-3 p-4">
          <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-brand-soft text-lg" aria-hidden="true">{f.icon}</span>
          <div>
            <h3 class="font-medium">{f.title}</h3>
            <p class="text-sm text-muted-foreground">{f.text}</p>
          </div>
        </Card>
      </li>
    ))}
  </ul>

  <div class="mt-4 grid gap-4 lg:grid-cols-3">
    <div data-reveal>
      <Card className="h-full">
        <CardHeader><CardTitle>{c.principlesTitle}</CardTitle></CardHeader>
        <CardContent>
          <ul class="list-disc space-y-2 pl-5 text-sm text-muted-foreground">
            {c.principles.map((p) => <li>{p}</li>)}
          </ul>
        </CardContent>
      </Card>
    </div>
    <div data-reveal style="--reveal-delay:80ms">
      <Card className="h-full">
        <CardHeader><CardTitle>{c.archTitle}</CardTitle></CardHeader>
        <CardContent>
          <dl class="divide-y text-sm">
            {c.stack.map(([k, v]) => (
              <div class="grid grid-cols-[5rem_1fr] gap-3 py-2">
                <dt class="text-xs font-medium tracking-wide text-muted-foreground uppercase">{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        </CardContent>
      </Card>
    </div>
    <div data-reveal style="--reveal-delay:160ms">
      <Card className="h-full">
        <CardHeader><CardTitle>{c.roadmapTitle}</CardTitle></CardHeader>
        <CardContent>
          <ol class="space-y-4">
            {c.roadmap.map((r) => (
              <li class="flex gap-3">
                <span class:list={["mt-1.5 size-2.5 shrink-0 rounded-full", dot[r.status]]} aria-hidden="true"></span>
                <div>
                  <p class="text-sm font-medium">{r.title}</p>
                  <p class="text-xs text-muted-foreground">{c.states[r.status]}</p>
                </div>
              </li>
            ))}
          </ol>
        </CardContent>
      </Card>
    </div>
  </div>
</Section>
