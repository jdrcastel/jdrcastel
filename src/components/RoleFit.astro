---
import { roleFit } from "../data/profile";
---

<section id="fit">
  <div class="wrap">
    <div data-reveal>
      <div class="eyebrow">// role fit</div>
      <h2>What I bring to a team</h2>
      <p class="lead">What full-stack, DevOps and cloud teams usually need, and the evidence I can point to.</p>
    </div>
    <div class="table-wrap" data-reveal>
      <table>
        <thead><tr><th>Area</th><th>Evidence</th></tr></thead>
        <tbody>
          {roleFit.map(([need, have]) => (
            <tr><td><span class="check">✓</span>{need}</td><td>{have}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .table-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; }
  table { width: 100%; border-collapse: collapse; font-size: 15px; }
  th, td { text-align: left; padding: 13px 16px; border-bottom: 1px solid var(--border); vertical-align: top; }
  tr:last-child td { border-bottom: 0; }
  tbody tr { transition: background 0.15s; }
  tbody tr:hover { background: var(--surface-2); }
  th { font-size: 12.5px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); font-weight: 600; }
  td:first-child { font-weight: 600; width: 36%; }
  td:last-child { color: var(--muted); }
  .check {
    display: inline-grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; margin-right: 8px;
    background: var(--ok-soft); color: var(--ok); font-size: 11px; vertical-align: 1px;
  }
  @media (max-width: 640px) {
    thead { display: none; }
    tr { display: block; padding: 12px 16px; border-bottom: 1px solid var(--border); }
    td { display: block; padding: 2px 0; border: 0; width: auto !important; }
  }
</style>
