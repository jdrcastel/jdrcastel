---
import Section from "./Section.astro";
import type { Content } from "@/i18n";

interface Props {
  t: Content;
}
const { t } = Astro.props;

// Words light up one line at a time as the reader scrolls (see .read-word); spaces stay plain text
const words = (text: string) => text.split(/(\s+)/);
---

<Section id="about" eyebrow={t.about.eyebrow} title={t.about.title}>
  <div class="max-w-3xl space-y-4 text-pretty" data-reveal>
    {t.about.paragraphs.map((p, i) => (
      <p class={i === 0 ? "text-lg" : "text-muted-foreground"}>
        {words(p).map((w) => (w.trim() ? <span class="read-word">{w}</span> : w))}
      </p>
    ))}
  </div>
</Section>
