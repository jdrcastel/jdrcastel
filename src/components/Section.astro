---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lead?: string;
  class?: string;
}
const { id, eyebrow, title, lead, class: className } = Astro.props;
---

<section id={id} class:list={["border-b py-20", className]} aria-labelledby={`${id}-title`}>
  <div class="mx-auto max-w-5xl px-4">
    <header class="mb-10 max-w-2xl" data-reveal>
      <p class="font-mono text-xs font-medium tracking-wider text-brand uppercase">{eyebrow}</p>
      <h2 id={`${id}-title`} class="mt-2 text-3xl font-semibold tracking-tight text-balance">
        <span class="title-mask"><span><slot name="title">{title}</slot></span></span>
      </h2>
      {lead && <p class="mt-3 text-pretty text-muted-foreground">{lead}</p>}
    </header>
    <slot />
  </div>
</section>
